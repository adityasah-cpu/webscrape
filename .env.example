# Database Configuration
# ⚠️ Never commit real passwords - use environment variables in production
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-secure-password-here
DB_NAME=job_portal

# Flask Configuration
# ⚠️ Generate a new secret key for production: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_SECRET_KEY=generate-new-key-with-python-secrets

# Google Sign-In OAuth
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# API Configuration
# Update these to match your production domain
API_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Resume Upload Configuration (in bytes)
MAX_RESUME_SIZE=5242880
MIN_RESUME_TEXT=30

# Optional: External ATS API endpoint
ATS_API_URL=https://qwen.cutm.ac.in/api/ats/evaluate

# Email Configuration (for alerts, optional)
# EMAIL_SENDER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_RECIPIENT=recipient@example.com
